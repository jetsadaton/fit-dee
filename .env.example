# Coachly env vars (see docs/onboarding.md for setup)

# Database (Neon Postgres)
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"

# Auth.js v5
AUTH_SECRET=""                   # openssl rand -base64 32
AUTH_LINE_ID=""
AUTH_LINE_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Kimi (OpenAI-compatible). Use the global endpoint (.ai) — the .cn endpoint
# is China-only and requires an RMB-billable Moonshot account.
KIMI_API_KEY=""
KIMI_BASE_URL="https://api.moonshot.ai/v1"

# LLM tracing — MVP logs prompt/token/latency directly into the `messages`
# table (kimi_request_id, token_in, token_out, latency_ms columns). External
# tracing (Helicone / Langfuse) deferred — add credentials here if added later.

# Vercel Blob
BLOB_READ_WRITE_TOKEN=""

# Upstash Redis (rate limit + cache)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Inngest (background jobs)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# USDA FoodData Central (food search fallback after Thai DB)
# Get free API key at: https://fdc.nal.usda.gov/api-guide/
USDA_API_KEY=""
